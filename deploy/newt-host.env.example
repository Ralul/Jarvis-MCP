# Host-level Newt (Pangolin client) — runs on the host OS, independent of Kubernetes.
# This ensures SSH access works even if MicroK8s is down.
#
# Setup:
#   1. Go to https://app.pangolin.net
#   2. Create a NEW site called "jarvis-host"
#   3. Generate Newt credentials (NEWT_ID + NEWT_SECRET)
#   4. Fill in the values below
#   5. sudo systemctl start newt-host
#   6. In Pangolin: add a TCP resource → target 127.0.0.1:22 (SSH)
#   7. SSH to the assigned port: ssh -p <port> worker@<pangolin-server>

NEWT_ID=your-newt-id-here
NEWT_SECRET=your-newt-secret-here
PANGOLIN_ENDPOINT=https://app.pangolin.net
